{
  "manifest_version": 3,
  "name": "IP Camera Audio Bridge",
  "description": "Аудиопоток IP-камеры (Kaicong ADPCM) через native messaging: декодирование и воспроизведение",
  "version": "1.1.0",
  "minimum_chrome_version": "109",
  "permissions": ["nativeMessaging", "storage", "offscreen"],
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "IP Camera Audio Bridge",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
